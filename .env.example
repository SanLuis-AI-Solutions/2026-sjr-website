# Environment variables template
# Canonical site URL (for metadataBase, sitemap/robots)
NEXT_PUBLIC_SITE_URL=https://www.susiesjewelryrepair.com

# Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Booking + Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Chicago
# Optional YYYY-MM-DD list for no-booking days, comma-separated (ex: 2026-12-25,2026-12-26)
NEXT_PUBLIC_BOOKING_BLACKOUT_DATES=
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_URL_QUOTES=
GOOGLE_CHAT_WEBHOOK_URL_BOOKINGS=
GOOGLE_CHAT_WEBHOOK_URL_CONTACTS=

# Lead email notifications (SMTP)
LEAD_EMAIL_TO=contact@susiesjewelryrepair.com
LEAD_EMAIL_TO_QUOTES=
LEAD_EMAIL_TO_BOOKINGS=
LEAD_EMAIL_TO_CONTACTS=
LEAD_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_SECURE accepts: true/false or ssl/tls
SMTP_USER=
SMTP_PASS=

# Admin (Basic Auth for /admin/*)
ADMIN_USER=
ADMIN_PASS=

# Supabase (leads/quotes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_QUOTES_BUCKET=quote-uploads
SUPABASE_QUOTES_MAX_FILES=4
SUPABASE_QUOTES_MAX_FILE_BYTES=8000000

# SJR Content Nexus (social dispatch)
NEXUS_SYNC_API_KEY=
NEXUS_DEFAULT_PLATFORMS=gbp,meta,pinterest,linkedin
NEXUS_GBP_ACCESS_TOKEN=
NEXUS_META_ACCESS_TOKEN=
NEXUS_PINTEREST_ACCESS_TOKEN=
NEXUS_LINKEDIN_ACCESS_TOKEN=

# Airtable (content sync)
AIRTABLE_PAT_TOKEN=
SEARCH_CONSOLE_PROPERTY=https://www.susiesjewelryrepair.com/
GA4_ACCOUNT_ID=
GA4_PROPERTY_ID=

# Stuller Showcase
NEXT_PUBLIC_STULLER_URL=
